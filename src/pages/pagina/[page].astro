---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import EventoCard from '../../components/EventoCard.astro';
import Paginacao from '../../components/Paginacao.astro';
import FilterBar from '../../components/FilterBar.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import data from '../../data/assuntos.json';

export const getStaticPaths = (({ paginate }) => {
  const sorted = [...data.assuntos].sort(
    (a, b) => b.data_evento.localeCompare(a.data_evento)
  );
  return paginate(sorted, { pageSize: 50 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const title = page.currentPage === 1
  ? 'Lawfare Timeline — 1400+ eventos documentados'
  : `Lawfare Timeline — Página ${page.currentPage}`;
const description = 'Cronologia documentada de abusos de poder, lawfare e escândalos políticos no Brasil desde 1979.';
---

<Base title={title} description={description} canonical={Astro.url.href}>
  <div class="page-header">
    <a href="/" class="back-link" data-pagefind-ignore>← Início</a>
    <h1 class="page-title">
      <span class="title-accent">Lawfare</span> Timeline
    </h1>
    <p class="page-sub">
      {data.total} eventos documentados · {page.lastPage} páginas
    </p>
  </div>

  <FilterBar categoriaAtiva={null} />

  <TagFilterBar tagSlugAtiva={null} />

  <div class="feed" data-pagefind-ignore>
    {page.data.map((evento) => (
      <EventoCard evento={evento} />
    ))}
  </div>

  <Paginacao
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    baseUrl="/pagina"
  />
</Base>
